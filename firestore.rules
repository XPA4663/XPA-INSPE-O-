rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function aclDoc() { return get(/databases/$(database)/documents/config/acl).data; }
    function hasAcl() { return exists(/databases/$(database)/documents/config/acl); }
    function isOwner() { return signedIn() && email() == 'xavier@xpaengenharia.com.br'; }
    function isAdmin() { return isOwner() || (signedIn() && hasAcl() && email() in aclDoc().admins); }
    function canProp() { return isAdmin() || (signedIn() && hasAcl() && email() in aclDoc().propostas); }

    // Trabalhos de inspeção: cada usuário só acessa os próprios (como já funcionava)
    match /data/users/{uid}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Propostas: somente usuários autorizados
    match /config/acl { allow read: if signedIn(); allow write: if isAdmin(); }
    match /config/contador_propostas { allow read, write: if canProp(); }
    match /config/uso_ia { allow read: if isAdmin(); allow write: if false; }
    match /propostas/{id} { allow read, write: if canProp(); }
  }
}
